# Selects which worker Compose starts. Committed on purpose: it holds no
# secrets, only the default profile, so `docker compose up` brings up a
# working stack with the fake pipeline (no GPU, no COLMAP needed).
#
# Every worker consumes the same Celery queue, so exactly one must run.
# Passing --profile on the command line replaces this value:
#
#   docker compose --profile gpu up --build   # NVIDIA GPU, real reconstruction
#   docker compose --profile cpu up --build   # no GPU, real but slow
#
# Put real secrets in .env.local or the environment; those stay ignored.
COMPOSE_PROFILES=fake
