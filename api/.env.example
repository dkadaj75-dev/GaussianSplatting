# Copy to api/.env for local overrides (the file is gitignored).

# SQLite for dev; postgresql+psycopg://user:pass@host/db in production.
DATABASE_URL=sqlite:///./data/splatscene.db

# Where uploaded photos are written: {STORAGE_DIR}/{project_id}/{photo_id}{ext}
STORAGE_DIR=./data/photos

# Comma-separated browser origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# 1 enables POST /api/dev/jobs/{id}/advance — never set this in production.
DEV_MODE=1

# Upload validation.
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif
MAX_PHOTO_BYTES=52428800

# Celery broker/result backend (used from WP 0.3 onward).
REDIS_URL=redis://localhost:6379/0
